# Postgres, matching docker-compose.yml
DB_NAME=squid
DB_PORT=23798
GQL_PORT=4350

# Ethereum JSON-RPC endpoint. Required: contract state reads go through it, and
# it is the standby data source behind Portal.
RPC_ETH_HTTP=

# Portal dataset. Defaults to the public mainnet dataset when unset.
# PORTAL_URL=https://portal.sqd.dev/datasets/ethereum-mainnet

# Only needed for a private or self-hosted portal; the public one is open.
# PORTAL_API_KEY=

# Pass budget for `sqd get-pools`. Lower means a higher cutoff and more
# wildcard blocks; higher means more passes over the pre-cutoff range.
# MAX_PASSES=5
